{
  "name": "motion-graphics-music-video-noimage",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Create music videos on macOS with native Swift motion graphics, beat mapping, procedural sound effects and Swift VFX.",
  "author": {
    "name": "makevoid",
    "url": "https://github.com/makevoid"
  },
  "homepage": "https://github.com/makevoid/motion-graphics-music-video-skill-noimage#readme",
  "repository": "https://github.com/makevoid/motion-graphics-music-video-skill-noimage",
  "keywords": [
    "music-video",
    "motion-graphics",
    "macos",
    "swift",
    "video"
  ],
  "skills": [
    "./.claude/skills/"
  ],
  "userConfig": {
    "FAL_AI_API_KEY": {
      "type": "string",
      "title": "Fal API key",
      "description": "Optional Fal API key for explicitly requested music, SFX, transcription and stem separation. Native Swift rendering needs no key.",
      "sensitive": true,
      "required": false
    }
  },
  "mcpServers": {
    "music-video-noimage": {
      "command": "ruby",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/.claude/skills/motion-graphics-music-video-noimage/scripts/mcp.rb"
      ],
      "env": {
        "FAL_AI_API_KEY_PLUGIN": "${user_config.FAL_AI_API_KEY}"
      }
    }
  }
}
